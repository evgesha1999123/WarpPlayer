<Window
    x:Class="Player.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Player"
    xmlns:Converter="using:Player.Utils.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Player.Views"
    mc:Ignorable="d"
    Title="WarpPlayer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <Grid.Resources>
            <Converter:PlaybackTimeConverter x:Key="PlaybackTimeConverter" />
            <Converter:SpeedPercentConverter x:Key="SpeedPercentConverter" />
            <Converter:VolumePercentConverter x:Key="VolumePercentConverter"/>
        </Grid.Resources>


        <!-- Верхняя панель -->
        <Grid Grid.Row="0">

            <!-- Управление скоростью и громкостью -->
            <StackPanel
                Orientation="Vertical"
                HorizontalAlignment="Left"
                Spacing="10"
                Margin="14,14,0,0">

                <!-- Скорость -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <TextBlock
                        Text="Скорость"
                        FontSize="8"
                        Width="40"
                        VerticalAlignment="Center" />

                    <Button Command="{x:Bind PlaybackVM.SetDefaultSpeedCommand}"
                            ToolTipService.ToolTip="Сбросить до обычной">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>

                    <Slider
                        Orientation="Horizontal"
                        Minimum="0.25"
                        Maximum="2"
                        StepFrequency="0.01"
                        Value="{x:Bind PlaybackVM.PlaybackSpeed, Mode=OneWay}"
                        ValueChanged="SpeedSlider_ValueChanged"
                        Width="200"
                        VerticalAlignment="Center"
                        ThumbToolTipValueConverter="{StaticResource SpeedPercentConverter}"/>

                </StackPanel>

                <!-- Громкость -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <TextBlock
                        Text="Громкость"
                        FontSize="8"
                        Width="40"
                        VerticalAlignment="Center" />

                    <Button Command="{x:Bind PlaybackVM.ToggleMuteCommand}">
                        <SymbolIcon Symbol="{x:Bind PlaybackVM.VolumeStateIcon, Mode=OneWay}" />
                    </Button>

                    <Slider
                        Orientation="Horizontal"
                        Minimum="0"
                        Maximum="1"
                        StepFrequency="0.01"
                        Value="{x:Bind PlaybackVM.Volume, Mode=OneWay}"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Width="200"
                        VerticalAlignment="Center" 
                        ThumbToolTipValueConverter="{StaticResource VolumePercentConverter}"/>

                </StackPanel>

            </StackPanel>


            <!-- Кнопки справа -->
            <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- Верхний ряд -->

                <!-- Добавить файлы -->
                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,4"
                    Command="{x:Bind PlaybackVM.SelectFilesCommand}"
                    ToolTipService.ToolTip="Добавить файлы">
                    <SymbolIcon Symbol="OpenFile" />
                </Button>

                <!-- Открыть папку -->
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4,0,0,4"
                    Command="{x:Bind PlaybackVM.SelectFolderCommand}"
                    ToolTipService.ToolTip="Указать папку с треками">
                    <SymbolIcon Symbol="Folder" />
                </Button>


                <!-- Нижний ряд -->

                <!-- Свернуть / развернуть плейлист -->
                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,4,4,0"
                    Command="{x:Bind PlaybackVM.ShowHidePlaylistCommand}"
                    ToolTipService.ToolTip="Скрыть / Показать плейлист">
                    <SymbolIcon Symbol="{x:Bind PlaybackVM.PlaylistButtonIcon, Mode=OneWay}" />
                </Button>

                <!-- Дополнительно -->
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="4,4,0,0"
                    ToolTipService.ToolTip="Дополнительно">
                    <SymbolIcon Symbol="More" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind PlaybackVM.ClearPlaylistCommand}"
                                Text="Очистить плейлист" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

            </Grid>

        </Grid>


        <Grid Grid.Row="2">
            <!-- Обложка -->
            <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Height="400">

                <Image
                    Source="{x:Bind PlaybackVM.CoverArt, Mode=OneWay}"
                    Stretch="UniformToFill" />

            </Grid>

            <!-- Плейлист -->
            <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,8,15,0">

                <views:PlaylistView
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MaxWidth="350"
                    MinWidth="100"
                    Visibility="{x:Bind PlaybackVM.PlaylistVisibility, Mode=OneWay}"
                    DataContext="{x:Bind PlaybackVM.PlaylistVM, Mode=OneWay}" />

            </Grid>

        </Grid>

        <!-- Слайдер воспроизведения -->
        <Slider
            x:Name="PlaybackSlider"
            Grid.Row="3"
            Minimum="0"
            Maximum="{x:Bind PlaybackVM.DisplayTotalTrackLenSeconds, Mode=OneWay}"
            Value="{x:Bind PlaybackVM.CurrentPlaybackTime, Mode=OneWay}"
            ValueChanged="PlaybackSlider_ValueChanged"
            Width="600"
            HorizontalAlignment="Center"
            ThumbToolTipValueConverter="{StaticResource PlaybackTimeConverter}" />

        <!-- Track Name -->
        <TextBlock
            Text="{x:Bind PlaybackVM.CurrentTrackNameUI, Mode=OneWay}"
            Grid.Row="4"
            FontSize="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            TextAlignment="Center"
            TextWrapping="NoWrap"
            Padding="0,0,0,16"/>

        <!-- Кнопки управления -->
        <StackPanel
            Grid.Row="5"
            Spacing="10"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">

            <!-- Текущее время -->
            <TextBlock
                Text="{x:Bind PlaybackVM.CurrentTrackPositionUI, Mode=OneWay}"
                FontSize="12"
                Padding="0,0,103,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Button
                Command="{x:Bind PlaybackVM.PreviousTrackCommand}">
                <SymbolIcon Symbol="Previous" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.BackwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9e;" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.TogglePlaybackCommand}">
                <SymbolIcon Symbol="{x:Bind PlaybackVM.PlayPauseIcon, Mode=OneWay}" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.ForwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9d;" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.NextTrackCommand}">
                <SymbolIcon Symbol="Next" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.StopCommand}">
                <SymbolIcon Symbol="Stop" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.TogglePlaybackModeCommand}"
                ToolTipService.ToolTip="{x:Bind PlaybackVM.PlaybackButtonToolTip, Mode=OneWay}">
                <SymbolIcon Symbol="{x:Bind PlaybackVM.PlaybackButtonIcon, Mode=OneWay}"/>
            </Button>

            <!-- Длительность -->
            <TextBlock
                Text="{x:Bind PlaybackVM.TrackDurationUI, Mode=OneWay}"
                FontSize="12"
                Padding="103,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </StackPanel>

        <TextBlock
            Grid.RowSpan="6"
            x:Name="NotificationBadgeText"
            Text="{x:Bind PlaybackVM.NotificationMessage, Mode=OneWay}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="14,0,0,14"
            FontSize="12"
            Opacity="0.8"
            TextWrapping="NoWrap"
            IsHitTestVisible="False" />

    </Grid>

</Window>
