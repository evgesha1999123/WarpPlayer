<Window
    x:Class="Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Test"
    xmlns:Utils="using:Test.Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Test">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Grid.Resources>
            <Utils:PlaybackTimeConverter x:Key="PlaybackTimeConverter" />
        </Grid.Resources>

        <!-- Управление скоростью -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Spacing="10"
            Margin="14,14,0,0">

            <TextBlock
                Text="Скорость"
                VerticalAlignment="Center" />

            <Slider
                Orientation="Horizontal"
                Minimum="0.25"
                Maximum="2"
                StepFrequency="0.01"
                Value="{x:Bind PlaybackVM.PlaybackSpeed, Mode=OneWay}"
                ValueChanged="SpeedSlider_ValueChanged"
                Width="200"
                VerticalAlignment="Center" />

        </StackPanel>

        <!-- Информация о текущем треке -->
        <Grid Grid.Row="1">
            <TextBlock
                Text="Artist — Track Name"
                FontSize="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <Grid Padding="0,20,20,0">
            <Border 
                HorizontalAlignment="Right">
                <Button Command="{x:Bind PlaybackVM.SelectFolderCommand}">
                    <SymbolIcon Symbol="Folder" />
                </Button>
            </Border>
        </Grid>

        <!-- Слайдер воспроизведения -->
        <Slider
            x:Name="PlaybackSlider"
            Grid.Row="2"
            Minimum="0"
            Maximum="{x:Bind PlaybackVM.DisplayTotalTrackLenSeconds, Mode=OneWay}"
            Value="{x:Bind PlaybackVM.CurrentPlaybackTime, Mode=OneWay}"
            ValueChanged="PlaybackSlider_ValueChanged"
            Width="600"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"
            ThumbToolTipValueConverter="{StaticResource PlaybackTimeConverter}">
        </Slider>

        <!-- Кнопки управления -->
        <StackPanel
            Grid.Row="3"
            Spacing="10"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">

            <!-- Текущее время проигрывателя -->
            <TextBlock
                Text="{x:Bind PlaybackVM.CurrentTrackPositionUI, Mode=OneWay}"
                FontSize="12"
                Padding="0,0,103,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />   

            <Button Command="{x:Bind PlaybackVM.PreviousTrackCommand}">
                <SymbolIcon Symbol="Previous" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.BackwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9e;" />
            </Button>

            <Button Command="{x:Bind PlaybackVM.TogglePlaybackCommand}">
                <SymbolIcon Symbol="{x:Bind PlaybackVM.PlayPauseIcon, Mode=OneWay}" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.ForwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9d;" />
            </Button>

            <Button Command="{x:Bind PlaybackVM.NextTrackCommand}">
                <SymbolIcon Symbol="Next" />
            </Button>

            <Button Command="{x:Bind PlaybackVM.StopCommand}">
                <SymbolIcon Symbol="Stop" />
            </Button>

            <!-- Длительность -->
            <TextBlock
                Text="{x:Bind PlaybackVM.TrackDurationUI, Mode=OneWay}"
                FontSize="12"
                Padding="103,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </StackPanel>

    </Grid>

</Window>
