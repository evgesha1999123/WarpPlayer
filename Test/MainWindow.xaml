<Window
    x:Class="Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Test"
    xmlns:Utils="using:Test.Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Test.Views"
    mc:Ignorable="d"
    Title="Test">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <Grid.Resources>
            <Utils:PlaybackTimeConverter x:Key="PlaybackTimeConverter" />
        </Grid.Resources>


        <!-- Верхняя панель -->
        <Grid Grid.Row="0">

            <!-- Управление скоростью -->
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Spacing="10"
                Margin="14,14,0,0">

                <TextBlock
                    Text="Скорость"
                    VerticalAlignment="Center" />

                <Slider
                    Orientation="Horizontal"
                    Minimum="0.25"
                    Maximum="2"
                    StepFrequency="0.01"
                    Value="{x:Bind PlaybackVM.PlaybackSpeed, Mode=OneWay}"
                    ValueChanged="SpeedSlider_ValueChanged"
                    Width="200"
                    VerticalAlignment="Center" />

            </StackPanel>


            <!-- Кнопки справа -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="8"
                Margin="0,14,14,0">

                <!-- Открыть папку -->
                <Button
                    Command="{x:Bind PlaybackVM.SelectFolderCommand}">

                    <SymbolIcon Symbol="Folder" />

                </Button>

                <!-- Свернуть / развернуть плейлист -->
                <Button
                    Command="{x:Bind PlaybackVM.ShowHidePlaylistCommand}">

                    <SymbolIcon
                        Symbol="{x:Bind PlaybackVM.PlaylistButtonIcon, Mode=OneWay}" />

                </Button>

            </StackPanel>

        </Grid>

        
        <!-- Основная область -->
        <Grid Grid.Row="1">


            <!-- Основной контент -->
            <TextBlock
                Text="{x:Bind PlaybackVM.CurrentTrackNameUI, Mode=OneWay}"
                FontSize="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Margin="20,0" />

            <!-- Плейлист -->
            <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,8,15,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:PlaylistView
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MaxWidth="350"
                    MinWidth="100"
                    Visibility="{x:Bind PlaybackVM.PlaylistVisibility, Mode=OneWay}"
                    DataContext="{x:Bind PlaybackVM.PlaylistVM, Mode=OneWay}" />

            </Grid>

        </Grid>


        <!-- Слайдер воспроизведения -->
        <Slider
            x:Name="PlaybackSlider"
            Grid.Row="2"
            Minimum="0"
            Maximum="{x:Bind PlaybackVM.DisplayTotalTrackLenSeconds, Mode=OneWay}"
            Value="{x:Bind PlaybackVM.CurrentPlaybackTime, Mode=OneWay}"
            ValueChanged="PlaybackSlider_ValueChanged"
            Width="600"
            HorizontalAlignment="Center"
            Margin="0,0,0,20"
            ThumbToolTipValueConverter="{StaticResource PlaybackTimeConverter}" />


        <!-- Кнопки управления -->
        <StackPanel
            Grid.Row="3"
            Spacing="10"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">

            <!-- Текущее время -->
            <TextBlock
                Text="{x:Bind PlaybackVM.CurrentTrackPositionUI, Mode=OneWay}"
                FontSize="12"
                Padding="0,0,103,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <Button
                Command="{x:Bind PlaybackVM.PreviousTrackCommand}">

                <SymbolIcon Symbol="Previous" />

            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.BackwardPlaybackRewindDelta}">

                <FontIcon Glyph="&#xeb9e;" />

            </Button>

            <Button
                Command="{x:Bind PlaybackVM.TogglePlaybackCommand}">

                <SymbolIcon
                    Symbol="{x:Bind PlaybackVM.PlayPauseIcon, Mode=OneWay}" />

            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.ForwardPlaybackRewindDelta}">

                <FontIcon Glyph="&#xeb9d;" />

            </Button>

            <Button
                Command="{x:Bind PlaybackVM.NextTrackCommand}">

                <SymbolIcon Symbol="Next" />

            </Button>

            <Button
                Command="{x:Bind PlaybackVM.StopCommand}">

                <SymbolIcon Symbol="Stop" />

            </Button>

            <!-- Длительность -->
            <TextBlock
                Text="{x:Bind PlaybackVM.TrackDurationUI, Mode=OneWay}"
                FontSize="12"
                Padding="103,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

        </StackPanel>

    </Grid>

</Window>
