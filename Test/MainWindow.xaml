<Window
    x:Class="Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Test"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Test">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Информация о текущем треке -->
        <Grid Grid.Row="0">
            <TextBlock
                Text="Artist — Track Name"
                FontSize="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>

        <!-- Слайдер воспроизведения -->
        <Slider
            x:Name="PlaybackSlider"
            Grid.Row="1"
            Minimum="0"
            Maximum="{x:Bind PlaybackVM.displayTotalTrackLenSeconds, Mode=OneWay}"
            Value="{x:Bind PlaybackVM.currentPlaybackTime, Mode=OneWay}"
            ValueChanged="PlaybackSlider_ValueChanged"
            Width="600"
            HorizontalAlignment="Center"
            Margin="0,0,0,20" />

        <!-- Кнопки управления -->
        <StackPanel
            Grid.Row="2"
            Spacing="10"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,20">

            <Button>
                <SymbolIcon Symbol="Previous" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.BackwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9e;" />
            </Button>

            <Button Command="{x:Bind PlaybackVM.TogglePlaybackCommand}">
                <SymbolIcon Symbol="{x:Bind PlaybackVM.playPauseIcon, Mode=OneWay}" />
            </Button>

            <Button
                Command="{x:Bind PlaybackVM.RewindCommand}"
                CommandParameter="{x:Bind PlaybackVM.ForwardPlaybackRewindDelta}">
                <FontIcon Glyph="&#xeb9d;" />
            </Button>

            <Button>
                <SymbolIcon Symbol="Next" />
            </Button>

            <Button Command="{x:Bind PlaybackVM.StopCommand}">
                <SymbolIcon Symbol="Stop" />
            </Button>

        </StackPanel>

        <StackPanel
        Grid.Column="0"
        VerticalAlignment="Center"
        HorizontalAlignment="Left"
        Spacing="7"
        Margin="14, 0, 0, 0">

            <TextBlock
            Text="Скорость"
            HorizontalAlignment="Left" />
            
            <!-- Слайдер скорости -->
            <Slider
            Orientation="Vertical"
            Minimum="0.25"
            Maximum="2"
            StepFrequency="0.01"
            Value="{x:Bind PlaybackVM.playbackSpeed, Mode=OneWay}"
            ValueChanged="SpeedSlider_ValueChanged"
            Height="250" 
            Margin="12, 0, 0, 0"/>

        </StackPanel>

    </Grid>

</Window>
