<UserControl
    x:Class="Test.Views.PlaylistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Test.Views">

    <Border
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="6">

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
                <views:TrackView />
            </StackPanel>

        </ScrollViewer>

    </Border>

</UserControl>
