<UserControl
    x:Class="Test.Views.TrackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Utils="using:Test.Utils">

	<Border
        BorderBrush="#3A3A3A"
        BorderThickness="1"
        Margin="0,0,12,4"
        Padding="10,8"
        CornerRadius="8"
        Background="Transparent">

		<Grid>
			<Grid.Resources>
				<Utils:PlaybackTimeConverter x:Key="PlaybackTimeConverter" />
			</Grid.Resources>

			<Grid.ColumnDefinitions>
				<!-- Play -->
				<ColumnDefinition Width="36" />
				
				<!-- Название + исполнитель -->
				<ColumnDefinition Width="*" MinWidth="140" />

				<!-- Длительность -->
				<ColumnDefinition Width="50" />

				<!-- Remove -->
				<ColumnDefinition Width="36" />
			</Grid.ColumnDefinitions>

			<!-- Play -->
			<Button
				Grid.Column="0"
				Width="32"
				Height="32"
				Padding="0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="Transparent"
				BorderThickness="0"
				Command="{Binding PlayCommand}">

				<SymbolIcon Symbol="Play" />
			</Button>

			<!-- Название + Artist -->
			<StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Margin="0,0,12,0">

				<TextBlock
                    Text="{Binding Title}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

				<TextBlock
                    Text="{Binding Artist}"
                    FontSize="12"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
			</StackPanel>

			<!-- Длительность -->
			<TextBlock
                Grid.Column="2"
                Text="{Binding Duration, Converter={StaticResource PlaybackTimeConverter}}"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,6,0" />

			<!-- Remove -->
			<Button
				Grid.Column="3"
				Width="32"
				Height="32"
				Padding="0"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Background="#8f112a"
				BorderThickness="0"
				Command="{Binding RemoveCommand}">

				<SymbolIcon Symbol="Delete" />
			</Button>
			
		</Grid>
	</Border>
</UserControl>